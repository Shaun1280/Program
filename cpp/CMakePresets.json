{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/cmake-build-${presetName}",
            "environment": {
                "PATH": "${sourceDir}/.pixi/envs/default/bin:$penv{PATH}",
                "CC": "${sourceDir}/.pixi/envs/default/bin/x86_64-conda-linux-gnu-cc",
                "CXX": "${sourceDir}/.pixi/envs/default/bin/x86_64-conda-linux-gnu-c++",
                "CFLAGS": "",
                "CXXFLAGS": "",
                "CPPFLAGS": "",
                "LDFLAGS": ""
            },
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "${sourceDir}/.pixi/envs/default",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug (pixi)",
            "description": "Debug build using the pixi environment in .pixi/",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "debug-clang",
            "displayName": "Debug Clang (pixi)",
            "description": "Debug build with Clang (required for WeeklyCPP reflection examples)",
            "inherits": "base",
            "environment": {
                "CC": "${sourceDir}/.pixi/envs/default/bin/clang-22",
                "CXX": "${sourceDir}/.pixi/envs/default/bin/clang++-22"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "displayName": "Release (pixi)",
            "description": "Release build using the pixi environment in .pixi/",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug",
            "jobs": 16
        },
        {
            "name": "debug-clang",
            "configurePreset": "debug-clang",
            "jobs": 16
        },
        {
            "name": "release",
            "configurePreset": "release",
            "jobs": 16
        }
    ],
    "testPresets": [
        {
            "name": "debug",
            "configurePreset": "debug",
            "execution": {
                "jobs": 16
            }
        },
        {
            "name": "release",
            "configurePreset": "release",
            "execution": {
                "jobs": 16
            }
        }
    ]
}
